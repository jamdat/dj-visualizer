{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch DJVisualizer (Fast F5)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/DJVisualizer.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build/bin",
      "terminal": "integrated",
      "stopOnEntry": false,
      "initCommands": [
        "settings set target.preload-symbols false",
        "settings set plugin.jit-loader.gdb.enable off"
      ],
      "preLaunchTask": "Build Release"
    },
    {
      "name": "Debug DJVisualizer (Full Symbols)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/DJVisualizer.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build/bin",
      "terminal": "integrated",
      "stopOnEntry": false,
      "preLaunchTask": "Build Release"
    }
  ]
}
